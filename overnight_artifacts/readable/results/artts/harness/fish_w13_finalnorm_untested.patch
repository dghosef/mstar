+def test_fast_ar_step_with_deferred_residuals_and_fused_gate_up_matches_the_block_chain():
+    """``FishFastAR.step`` (residual adds deferred into the norms) and the
+    stacked gate/up GEMM compute what the plain block chain does."""
+    from mstar.model.fish_s2_pro.components.fast_ar import FishFastAR
+    from mstar.model.fish_s2_pro.config import FishFastARConfig
+
+    torch.manual_seed(0)
+    cfg = FishFastARConfig(
+        dim=64, text_dim=64, n_layer=2, n_head=4, n_local_heads=2, head_dim=16,
+        intermediate_size=96, vocab_size=32, num_codebooks=4,
+    )
+    fast_ar = FishFastAR(cfg).eval()
+    for param in fast_ar.parameters():
+        torch.nn.init.normal_(param, std=0.2)
+    x = torch.randn(3, 1, cfg.dim)
+
+    def chain(kv, pos):
+        freqs = fast_ar.freqs_cis[pos:pos + 1].unsqueeze(0)
+        h = x.clone()
+        for i, layer in enumerate(fast_ar.layers):
+            h = layer(h, freqs, kv[i], pos)
+        return fast_ar.norm(h)
+
+    with torch.no_grad():
+        kv = torch.zeros(fast_ar.kv_cache_shape(3))
+        expected = [chain(kv, pos) for pos in range(3)]
+        fast_ar.fuse_projections()
+        kv = torch.zeros(fast_ar.kv_cache_shape(3))
+        got = [fast_ar.step(x.clone(), kv, pos) for pos in range(3)]
+    for e, g in zip(expected, got, strict=True):
+        torch.testing.assert_close(g, e, atol=1e-5, rtol=1e-5)
