+    def fuse_gate_up(self) -> None:
+        """Stack ``w1`` and ``w3`` into one ``[2 * intermediate, dim]`` GEMM
+        (after loading; the checkpoint names stay on ``w1`` / ``w3``)."""
+        with torch.no_grad():
+            self.w13 = torch.cat([self.w1.weight, self.w3.weight]).contiguous()
+        # the stacked copy replaces them; keep only an empty shell of each
+        self.w1.weight = nn.Parameter(self.w1.weight.new_empty(0), requires_grad=False)
+        self.w3.weight = nn.Parameter(self.w3.weight.new_empty(0), requires_grad=False)
 
