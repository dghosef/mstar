+def test_t3_decode_batch_embeds_each_row_at_its_own_position():
+    sub = _t3_submodule()
+    rows = {"a": (17, 1), "b": (40, 3)}  # rid -> (previous token, tokens generated so far)
+    inputs = []
+    for rid, (token, generated) in rows.items():
+        info = _fwd_info(rid)
+        sub.prepare_inputs("prefill", info, {TEXT_INPUTS: [torch.tensor([255, 0])]})
+        sub.request_state(rid).add("generated", generated)
+        inputs.append(sub.prepare_inputs("decode", info, {PREV_TOKEN: [torch.tensor([token])]}))
+    # a padded replay appends the capture template's row
+    (template,) = [
+        c.single_request_inputs for c in sub.get_accelerator_graph_configs(torch.device("cpu"))
+        if isinstance(c, BatchedAcceleratorGraphConfig) and c.additional_key_info is True
+    ]
+    inputs.append(template)
+    packed = sub.preprocess("decode", ModelInputsFromEngine(request_ids=list(rows), per_request_info={}), inputs)
+    main = torch.cat([
+        sub.model.embed_speech(torch.tensor([token]), generated)
+        for token, generated in [*rows.values(), (0, 0)]
+    ])
+    # guidance: the same token embedding feeds the cond and uncond streams
+    assert torch.equal(packed["input_embeds"], torch.cat([main, main]))
+    assert packed["cfg_weight"].tolist() == [[0.5], [0.5], [0.5]]
