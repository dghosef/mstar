 from mstar.model.chatterbox.config import S3GenHiFTConfig
 
 
+def overlap_add_istft(spec: torch.Tensor, n_fft: int, hop: int, window: torch.Tensor) -> torch.Tensor:
+    """``torch.istft(spec, n_fft, hop, n_fft, window=window)`` (centered,
+    one-sided), minus its check that the window envelope is nonzero: that
+    check reads a device value on the host, which stalls the CPU until the
+    vocoder has run. The periodic Hann window at a quarter-frame hop never
+    trips it. ``spec``: ``[B, n_fft // 2 + 1, frames]`` -> ``[B, hop * (frames - 1)]``.
+    """
+    frames = torch.fft.irfft(spec, n=n_fft, dim=1) * window.view(1, -1, 1)
+    num_frames = frames.shape[-1]
+    length = n_fft + hop * (num_frames - 1)
+    fold = dict(output_size=(1, length), kernel_size=(1, n_fft), stride=(1, hop))
+    signal = F.fold(frames, **fold).view(frames.shape[0], length)
+    envelope = F.fold(window.square().view(1, -1, 1).expand(1, -1, num_frames), **fold).view(1, length)
+    half = n_fft // 2
+    return signal[:, half : length - half] / envelope[:, half : length - half]
+
+
 def _get_padding(kernel_size: int, dilation: int = 1) -> int:
     return int((kernel_size * dilation - dilation) / 2)
 
