+    def _warm_vocoder(self, s3gen) -> None:
+        """Compile the vocoder's dynamic-shape graphs (with and without an
+        excitation cache) at startup rather than on the first requests."""
+        n_mel, device, dtype = self.config.s3gen.output_size, s3gen.device, s3gen.dtype
+        cache = self.config.stream_mel_cache_frames * self.config.s3gen.hift.upsample_factor
+        gen = torch.Generator(device=device).manual_seed(0)
+        with torch.no_grad():
+            for frames in (64, 96):
+                mel = torch.randn(1, n_mel, frames, device=device, dtype=dtype, generator=gen)
+                _, source = s3gen.vocode(mel, generator=gen)
+                s3gen.vocode(mel, generator=gen, cache_source=source[:, :, -cache:], fade_in=False)
